# Use a DEV/TEST Supabase project only. These tests create and delete data and change app_settings.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
# Node-only. Never put this in a VITE_ variable or in browser code.
TEST_SERVICE_ROLE_KEY=
# Optional: set to 1 to run the live AI test (needs ai-chat deployed with GEMINI_API_KEY)
RUN_AI_TESTS=
